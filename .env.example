# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=text
REDACT_PII_LOGS=false

# OpenAI / CrewAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
CREW_VERBOSE=false

# HTTP API
SERVICE_API_KEY=change-me-in-production
RATE_LIMIT=60/minute
JOB_WORKER_COUNT=2

# Optional OIDC (Bearer JWT). When set, validates tokens from your IdP.
# OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# OIDC_AUDIENCE=your-app-client-id

# PostgreSQL (optional — omit to use data/employees.json)
# DATABASE_URL=postgresql+psycopg://employee:employee@localhost:5432/employee_db

# Optional overrides
# EMPLOYEE_DATA_FILE=./data/employees.json
# API_HOST=0.0.0.0
# API_PORT=8000
